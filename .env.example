# Copy to .env (git-ignored) and fill in. Only needed from Phase 3 onward (LLM arms).
# Phases 1-2 and replay mode need no keys.

# OpenRouter: one key for every model. Create a dedicated key with a credit limit
# of $2.10 (≈ ₹200) at https://openrouter.ai/settings/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# Which model this run uses (OpenRouter model ID); defaults to configs/experiment.yaml llm.models.cheap
LLM_MODEL=deepseek/deepseek-v4.1-flash

# live | replay | mock  (replay reads llm_cache/ only and fails on a miss; mock is an offline
# scripted policy for dry runs; neither costs anything). The runner's --llm flag overrides this.
LLM_MODE=replay

# Optional: direct Anthropic API instead of OpenRouter (console.anthropic.com).
# LLM_PROVIDER=anthropic
# A Claude Pro subscription does not include API access.
# ANTHROPIC_API_KEY=
